{
  "name": "lndf",
  "version": "0.2.0",
  "description": "Validate and parse LNDF judgment records: in-code comments, commit trailers, .lndf files and git history. validate is a port of the lndf-comment validator.",
  "keywords": [
    "lndf",
    "llm",
    "coding-agent",
    "commit-trailer",
    "validator",
    "parser"
  ],
  "homepage": "https://github.com/moncface/lndf#readme",
  "bugs": "https://github.com/moncface/lndf/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moncface/lndf.git",
    "directory": "cli"
  },
  "license": "Apache-2.0",
  "author": "moncface (https://moncface.com)",
  "type": "module",
  "bin": {
    "lndf": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.js\"",
    "prepack": "npm run build && node -e \"require('fs').copyFileSync('../LICENSE','LICENSE')\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
